{
  "name": "tanstack_start_ts",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "bun run sync:route-seo && bun run gen:asset-og && bun run gen:social-hashes && bun run gen:sitemap && bun run test:security && bun run test:seo:social && vite build && bun run ping:indexing",
    "build:dev": "bun run sync:route-seo && bun run gen:asset-og && bun run gen:social-hashes && bun run gen:sitemap && bun run test:security && bun run test:seo:social && vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "cap:sync": "cap sync",
    "cap:open:ios": "cap open ios",
    "cap:open:android": "cap open android",
    "cap:assets": "capacitor-assets generate --iconBackgroundColor '#0B0F19' --splashBackgroundColor '#0B0F19'",
    "gen:social-hashes": "node scripts/social-image-hashes.mjs",
    "gen:asset-og": "node scripts/asset-og-sync.mjs",
    "gen:asset-og:force": "node scripts/asset-og-sync.mjs --force",
    "check:asset-og": "node scripts/asset-og-sync.mjs --check",
    "sync:route-seo": "node scripts/route-seo-sync.mjs",
    "check:route-seo": "node scripts/route-seo-sync.mjs --check",
    "sync:seo": "node scripts/route-seo-sync.mjs && node scripts/gen-sitemap.mjs",
    "gen:sitemap": "node scripts/gen-sitemap.mjs",
    "check:sitemap": "node scripts/gen-sitemap.mjs --check",
    "check:robots": "node scripts/validate-robots.mjs",
    "check:social-hashes": "node scripts/social-image-hashes.mjs --check",
    "lint:supabase": "node scripts/supabase-lint-check.mjs",
    "lint:supabase:live": "node scripts/supabase-lint-check.mjs --live",
    "lint:supabase:authz": "node scripts/supabase-authz-check.mjs",
    "test:security": "vitest run --config vitest.security.config.ts",
    "test:seo": "vitest run --config vitest.seo.config.ts",
    "test:seo:social": "vitest run --config vitest.seo.config.ts src/tests/seo/social-tags.test.ts",
    "test:seo:jsonld": "vitest run --config vitest.seo.config.ts src/tests/seo/jsonld-rich-results-e2e.test.ts",
    "test:seo:cards": "vitest run --config vitest.seo.config.ts src/tests/seo/social-cards-e2e.test.ts",
    "check:social-tags": "bun scripts/social-tags-build-check.mjs",
    "check:social-tags:json": "bun scripts/social-tags-build-check.mjs --json",
    "check:jsonld": "bun scripts/jsonld-build-check.mjs",
    "gen:schema-vocab": "node scripts/gen-schema-vocabulary.mjs",
    "check:schema-vocab": "node scripts/gen-schema-vocabulary.mjs --check",
    "check:schema-org": "bun scripts/schema-org-check.mjs",
    "check:schema-org:json": "bun scripts/schema-org-check.mjs --json",
    "test:seo:schema-org": "vitest run --config vitest.seo.config.ts src/tests/seo/schema-org-vocabulary.test.ts",
    "check:jsonld:json": "bun scripts/jsonld-build-check.mjs --json",
    "check:rich-results": "bun scripts/rich-results-check.mjs",
    "check:rich-results:json": "bun scripts/rich-results-check.mjs --json",
    "test:seo:journal-dates": "vitest run --config vitest.seo.config.ts src/tests/seo/journal-article-dates.test.ts",
    "test:seo:journal-images": "vitest run --config vitest.seo.config.ts src/tests/seo/journal-twitter-image-parity.test.ts",
    "test:seo:hreflang": "vitest run --config vitest.seo.config.ts src/tests/seo/hreflang.test.ts",
    "test:seo:journal-parity": "vitest run --config vitest.seo.config.ts src/tests/seo/journal-article-parity.test.ts",
    "check:og-images": "bun scripts/og-image-check.mjs",
    "check:og-images:json": "bun scripts/og-image-check.mjs --json",
    "check:og-images:remote": "bun scripts/og-image-check.mjs --remote",
    "ping:indexing": "node scripts/ping-indexing.mjs",
    "ping:indexing:all": "node scripts/ping-indexing.mjs --all",
    "ping:indexing:dry": "node scripts/ping-indexing.mjs --dry-run",
    "test:security:coverage": "node scripts/security-coverage-summary.mjs",
    "test:seo:pagination": "vitest run --config vitest.seo.config.ts src/tests/seo/journal-pagination.test.ts"
  },
